{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeadRS Overlay",
  "version": "0.1.0",
  "identifier": "dev.deadlockplus.deadrs-overlay",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "DeadRS Overlay",
        "width": 1040,
        "height": 820,
        "minWidth": 620,
        "minHeight": 320,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "center": true,
        "theme": "Dark",
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://assets-bucket.deadlock-api.com https://api.deadlock-api.com; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
